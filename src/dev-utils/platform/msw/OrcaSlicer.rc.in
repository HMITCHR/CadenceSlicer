1 VERSIONINFO
FILEVERSION @SLIC3R_VERSION@
PRODUCTVERSION @SLIC3R_VERSION@
{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904E4"
  {
   VALUE "CompanyName", "@CADENCE_COMPANY_NAME@"
   VALUE "FileDescription", "Cadence Slicer"
   VALUE "FileVersion", "@SLIC3R_BUILD_ID@"
   VALUE "ProductName", "Cadence Slicer"
   VALUE "ProductVersion", "@SLIC3R_BUILD_ID@"
   VALUE "InternalName", "@SLIC3R_APP_NAME@"
   VALUE "LegalCopyright", "Copyright (C) 2026 Cadence Slicer contributors. Based on OrcaSlicer, Copyright (C) SoftFever and the OrcaSlicer contributors."
   VALUE "OriginalFilename", "CadenceSlicer.exe"
  }
 }
 BLOCK "VarFileInfo"
 {
   VALUE "Translation", 0x409, 1252
 }
}
2 ICON "@SLIC3R_RESOURCES_DIR@/images/CadenceSlicer.ico"
1 24 "OrcaSlicer.manifest" 
