# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

set(SLIC3R_APP_NAME "CadenceSlicer")
set(SLIC3R_APP_KEY "CadenceSlicer")
# CompanyName in the Windows version resource (OrcaSlicer.rc.in). Set it here and
# nowhere else.
set(CADENCE_COMPANY_NAME "HMITCHR")

if(NOT DEFINED BBL_INTERNAL_TESTING)
set(BBL_INTERNAL_TESTING "0")
endif()
# The version the product presents to the user: the About dialog, the HTTP user
# agent and the package name. Nothing compares a file or a configuration against
# this.
set(CADENCE_PRODUCT_VERSION "1.0.1")

# NOT the product version, despite the name. SoftFever_VERSION is the project
# file and configuration version. It is written into every exported 3MF and into
# saved configuration, and both the CLI and the GUI compare a loaded project's
# saved version against it to decide whether the project is newer than the
# application. It therefore has to sort at or above the version of any project a
# user can open, which means staying on the upstream scheme.
#
# Moving it to the Cadence product version made the application refuse every
# existing project: a 3MF saved as 2.5.0.0-dev read as newer than 0.1.0-beta, so
# the CLI exited 232 and the GUI offered geometry only. See W58. If this is ever
# changed again it must stay at or above 2.5.0-dev, the version upstream saves at
# the base commit recorded below.
set(SoftFever_VERSION "2.5.0-dev")

# Upstream OrcaSlicer commit this fork branched from. Shown in the About dialog
# so a build can be traced back to the source it was derived from.
set(CADENCE_UPSTREAM_BASE_COMMIT "c806a09c7c")

# The package version, so the installer and the DMG carry the product version.
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)"
       CADENCE_PRODUCT_VERSION_MATCH ${CADENCE_PRODUCT_VERSION})
set(ORCA_VERSION_MAJOR ${CMAKE_MATCH_1})
set(ORCA_VERSION_MINOR ${CMAKE_MATCH_2})
set(ORCA_VERSION_PATCH ${CMAKE_MATCH_3})

# Also not the product version. This is the Bambu Studio compatibility number
# written into exported 3MF files and used by the printer-facing code paths, so
# it stays on the upstream scheme to keep 3MF and preset compatibility.
set(SLIC3R_VERSION "02.08.01.55")

if (NOT DEFINED ORCA_UPDATER_SIG_KEY)
    set(ORCA_UPDATER_SIG_KEY "" CACHE STRING "Base64url encoded updater signature key")
endif()
